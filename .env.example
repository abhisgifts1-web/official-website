# ABHI GIFTS — ENVIRONMENT CONFIGURATION

# Next.js Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas Connection URI
# Leave blank to use the high-performance in-memory demo store
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/abhi_gifts?retryWrites=true&w=majority

# Admin Authentication Secret (Used for signing secure JWT cookies)
ADMIN_JWT_SECRET=abhi-gifts-super-secure-production-jwt-key-2026

# Razorpay Online Payment Gateway
# In test mode or when left blank, the checkout uses our realistic instant simulator
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId123
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Cloudinary Storage for Image Uploads
CLOUDINARY_CLOUD_NAME=abhi-gifts
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# WhatsApp Business Hotline (Numbers only with country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=917780269927
